# ---- Server ----
PORT=3000
# Public URL of this service (used by the widget and docs page)
PUBLIC_URL=http://localhost:3000
# Long random string. Used to hash OTPs and sign verification tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=change-me-to-a-long-random-string
# Where registered client apps are stored
DATA_FILE=./data/apps.json
# Country code prepended when a number is sent without one (91 = India)
DEFAULT_COUNTRY_CODE=91

# ---- OTP policy ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Max OTPs sent to one mobile number per hour
OTP_MAX_SENDS_PER_HOUR=5
# Max API requests per IP per minute
IP_REQUESTS_PER_MINUTE=60

# ---- SMS provider: console | msg91 | twilio | webhook ----
SMS_PROVIDER=console

# MSG91 (https://msg91.com) - uses the Flow/SendOTP template API.
# Your DLT-approved template must contain the variable ##otp##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Generic webhook: POSTs {to, message, otp} as JSON to this URL
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Message template for providers that send raw text (twilio, webhook, console)
SMS_TEMPLATE="{otp} is your {app} verification code. It expires in {minutes} minutes. Do not share it with anyone."
