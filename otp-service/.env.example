# ---- Server ----
PORT=3000
# Public URL of this service (on Vercel it is detected automatically)
PUBLIC_URL=http://localhost:3000
# Long random string. Used to hash OTPs and sign verification tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=change-me-to-a-long-random-string
# Password for the /admin panel (add websites, pair gateway phones)
ADMIN_PASSWORD=
# Country code added when a number is typed without one (91 = India)
DEFAULT_COUNTRY_CODE=91

# ---- Database ----
# Upstash Redis REST credentials. On Vercel, connecting a Redis (Upstash) store sets these.
# Leave empty locally to keep everything in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- OTP policy ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Max verifications started for one mobile number per hour (per website)
OTP_MAX_SENDS_PER_HOUR=5
# Max API requests per IP per minute
IP_REQUESTS_PER_MINUTE=60

# ---- Gateway phone ----
# How often the gateway app checks for SMS to send (seconds). Lower = faster SMS, more requests.
GATEWAY_POLL_SECONDS=10
# Optional: number customers ring for missed calls (default: the number typed into the app)
MISSED_CALL_NUMBER=

# ---- SMS sender: phone (your gateway phone, default) | console | msg91 | twilio | webhook ----
SMS_PROVIDER=phone
SMS_TEMPLATE="{otp} is your {app} verification code. It expires in {minutes} minutes. Do not share it with anyone."

# Optional paid gateways (only if SMS_PROVIDER is set to them)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
