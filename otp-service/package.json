{
  "name": "otp-service",
  "version": "1.0.0",
  "description": "Self-hosted real-time mobile number verification (OTP) service with API + embeddable widget, similar to MSG91 OTP.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "create-app": "node --env-file-if-exists=.env scripts/create-app.js",
    "test": "node --test"
  },
  "license": "MIT"
}
